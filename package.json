{
  "name": "meal-decision-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "node scripts/prisma-cli.mjs generate",
    "lint": "next lint",
    "db:generate": "node scripts/prisma-cli.mjs generate",
    "db:push": "node scripts/prisma-cli.mjs db push --skip-generate",
    "db:seed": "node scripts/run-seed.mjs",
    "openclaw:lunch": "node scripts/openclaw-daily-runner.mjs --mealType lunch --write",
    "openclaw:dinner": "node scripts/openclaw-daily-runner.mjs --mealType dinner --write",
    "openclaw:chat": "node scripts/openclaw-chat-feedback.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prisma": "^6.0.0",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}
